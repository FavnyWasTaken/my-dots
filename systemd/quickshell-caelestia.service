[Unit]
Description=Caelestia Quickshell Shell
After=graphical-session.target

[Service]
Environment=CAELESTIA_LIB_DIR=%h/.config/quickshell/caelestia/build/lib
Environment=QML2_IMPORT_PATH=%h/.config/quickshell/caelestia/build/qml
ExecStart=/usr/bin/quickshell -p %h/.config/quickshell/caelestia/shell.qml
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
